NODE_ENV=development
APP_ENV=development
API_PORT=8000
# Comma-separated IPs/CIDRs for reverse proxies allowed to supply X-Forwarded-For.
TRUSTED_PROXIES=
RATE_LIMIT_CATALOG_PER_MINUTE=600
RATE_LIMIT_NORMAL_PER_MINUTE=120
RATE_LIMIT_STRICT_PER_MINUTE=30
DATABASE_URL=postgresql://shubayr:shubayr_secret@localhost:5432/shubayr?schema=public
REDIS_URL=redis://localhost:6379
NOTIFICATION_PROVIDER=dev
# For NOTIFICATION_PROVIDER=fcm, set these through the deployment secret store.
# Base64-encode the complete Firebase service-account JSON; never commit it.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON_BASE64=
# Internal CLI safeguards. Values are comma-separated; leave empty to disable.
PUSH_TEST_ACCOUNTS=
PUSH_TEST_OPERATORS=
PUSH_DEVICE_MAX_AGE_DAYS=45
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=masterKey_dev_only
JWT_SECRET=replace_with_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_32_character_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ADMIN_REFRESH_ROTATION_GRACE_SECONDS=30
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_PHONE_WINDOW_MAX=3
OTP_PHONE_WINDOW_SECONDS=600
# Rolling 24-hour limit (not a calendar-day reset).
OTP_PHONE_DAILY_MAX=10
OTP_IP_HOURLY_MAX=60
DEV_OTP=000000
# gateway preserves the existing { phone, code } integration. Use otpiq to opt in.
SMS_PROVIDER=gateway
# Backend secret store only: the API key for OTPIQ project shubayr. Never put in Flutter.
OTPIQ_API_KEY=
# Submission budget (1000-15000 ms). No automatic POST retries.
OTPIQ_TIMEOUT_MS=10000
# Best-effort worker tracking budget after a submission is accepted.
OTPIQ_TRACKING_TIMEOUT_MS=120000
# APP_ENV=development always bypasses SMS and retains DEV_OTP, even with otpiq selected.
# Required in production only with SMS_PROVIDER=gateway.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3100
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=shubayr-media
S3_ACCESS_KEY=shubayr
S3_SECRET_KEY=shubayr_minio_secret
MEDIA_MAX_BYTES=8388608
