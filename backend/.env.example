NODE_ENV=development
APP_ENV=development
API_PORT=8000
DATABASE_URL=postgresql://shubayr:shubayr_secret@localhost:5432/shubayr?schema=public
REDIS_URL=redis://localhost:6379
NOTIFICATION_PROVIDER=dev
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=masterKey_dev_only
JWT_SECRET=replace_with_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_32_character_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_TTL_SECONDS=300
DEV_OTP=000000
# Required only when APP_ENV=production. The gateway receives { phone, code }.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3100
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=shubayr-media
S3_ACCESS_KEY=shubayr
S3_SECRET_KEY=shubayr_minio_secret
MEDIA_MAX_BYTES=8388608
