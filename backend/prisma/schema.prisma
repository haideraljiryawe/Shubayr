// Runtime database model. Prisma Migrate files are the authoritative upgrade
// path; ../../infra/db/schema.sql is a synchronized bootstrap/reference.
// PostgreSQL CHECK constraints and partial indexes that Prisma cannot express
// are retained explicitly in migrations and schema.sql.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// All monetary Decimal fields use scale 2. Services calculate with integer
// minor units and round half away from zero at the resulting money boundary.

model StoreSetting {
  id         String   @id(map: "store_settings_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key        String   @unique(map: "store_settings_key_key") @db.VarChar(120)
  value      String?  @db.Text
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("store_settings")
}

model Role {
  id               String           @id(map: "roles_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String           @unique(map: "roles_name_key") @db.VarChar(80)
  description      String?          @db.VarChar(255)
  is_system        Boolean          @default(false)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  role_permissions RolePermission[]
  users            User[]

  @@map("roles")
}

model Permission {
  id               String           @id(map: "permissions_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key              String           @unique(map: "permissions_key_key") @db.VarChar(120)
  group            String           @db.VarChar(80)
  description      String?          @db.VarChar(255)
  role_permissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_id       String     @db.Uuid
  permission_id String     @db.Uuid
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_permissions_role_id_fkey")
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_permissions_permission_id_fkey")

  @@id([role_id, permission_id], map: "role_permissions_pkey")
  @@map("role_permissions")
}

model User {
  id                        String                  @id(map: "users_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_id                   String                  @db.Uuid
  name                      String?                 @db.VarChar(120)
  phone                     String                  @unique(map: "users_phone_key") @db.VarChar(32)
  email                     String?                 @db.VarChar(160)
  password_hash             String?                 @db.VarChar(255)
  is_active                 Boolean                 @default(true)
  created_at                DateTime                @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                @default(now()) @db.Timestamptz(6)
  role                      Role                    @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "users_role_id_fkey")
  addresses                 Address[]
  purchase_invoices         PurchaseInvoice[]       @relation("PurchaseInvoiceCreatedBy")
  stock_movements           StockMovement[]         @relation("StockMovementUser")
  cart                      Cart?
  wishlist_items            WishlistItem[]
  orders                    Order[]
  assigned_pick_lists       PickList[]              @relation("PickListAssignee")
  assigned_deliveries       Delivery[]              @relation("DeliveryAgent")
  returns                   Return[]
  product_reviews           ProductReview[]
  delivery_ratings_as_agent DeliveryRating[]        @relation("DeliveryRatingAgent")
  delivery_ratings_as_user  DeliveryRating[]        @relation("DeliveryRatingUser")
  loyalty_account           LoyaltyAccount?
  audit_logs                AuditLog[]              @relation("AuditActor")
  device_tokens             DeviceToken[]
  notification_preferences  NotificationPreference?
  refresh_tokens            RefreshToken[]
  uploaded_media            MediaObject[]           @relation("MediaUploadedBy")

  @@map("users")
}

model OtpCode {
  id          String    @id(map: "otp_codes_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone       String    @db.VarChar(32)
  code_hash   String    @db.VarChar(255)
  expires_at  DateTime  @db.Timestamptz(6)
  consumed_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([phone, consumed_at, created_at], map: "idx_otp_codes_phone_active")
  @@map("otp_codes")
}

model RefreshToken {
  id         String    @id(map: "refresh_tokens_pkey") @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique(map: "refresh_tokens_token_hash_key") @db.VarChar(64)
  expires_at DateTime  @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "refresh_tokens_user_id_fkey")

  @@index([user_id], map: "idx_refresh_tokens_user")
  @@index([expires_at], map: "idx_refresh_tokens_expiry")
  @@map("refresh_tokens")
}

model MediaObject {
  id          String   @id(map: "media_objects_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  object_key  String   @unique(map: "media_objects_object_key_key") @db.VarChar(512)
  public_url  String   @unique(map: "media_objects_public_url_key") @db.Text
  mime_type   String   @db.VarChar(80)
  size_bytes  Int
  checksum    String   @db.VarChar(64)
  uploaded_by String?  @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  uploader    User?    @relation("MediaUploadedBy", fields: [uploaded_by], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "media_objects_uploaded_by_fkey")

  @@index([uploaded_by], map: "idx_media_objects_uploader")
  @@map("media_objects")
}

model Address {
  id            String   @id(map: "addresses_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  label         String?  @db.VarChar(80)
  city          String   @db.VarChar(80)
  area          String?  @db.VarChar(120)
  street        String?  @db.VarChar(160)
  details       String?  @db.Text
  contact_phone String   @db.VarChar(32)
  lat           Float?   @db.DoublePrecision
  lng           Float?   @db.DoublePrecision
  is_default    Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "addresses_user_id_fkey")
  orders        Order[]

  @@map("addresses")
}

model DeviceToken {
  id         String   @id(map: "device_tokens_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  token      String   @db.VarChar(512)
  platform   String   @db.VarChar(16)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "device_tokens_user_id_fkey")

  @@unique([user_id, token], map: "device_tokens_user_id_token_key")
  @@index([user_id], map: "idx_device_tokens_user")
  @@map("device_tokens")
}

model NotificationPreference {
  user_id          String   @id(map: "notification_preferences_pkey") @db.Uuid
  order_updates    Boolean  @default(true)
  delivery_updates Boolean  @default(true)
  return_updates   Boolean  @default(true)
  loyalty_updates  Boolean  @default(true)
  promotions       Boolean  @default(false)
  updated_at       DateTime @default(now()) @db.Timestamptz(6)
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "notification_preferences_user_id_fkey")

  @@map("notification_preferences")
}

model Category {
  id             String     @id(map: "categories_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parent_id      String?    @db.Uuid
  name_en        String     @db.VarChar(120)
  name_ar        String     @db.VarChar(120)
  slug           String?    @unique(map: "idx_categories_slug") @db.VarChar(140)
  description_en String?    @db.Text
  description_ar String?    @db.Text
  image_url      String?    @db.Text
  icon_key       String?    @db.VarChar(80)
  sort_order     Int        @default(0)
  is_visible     Boolean    @default(true)
  parent         Category?  @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "categories_parent_id_fkey")
  children       Category[] @relation("CategoryHierarchy")
  products       Product[]

  @@map("categories")
}

model Banner {
  id         String    @id(map: "banners_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String    @db.VarChar(200)
  subtitle   String?   @db.Text
  image_url  String    @db.Text
  cta_text   String?   @db.VarChar(120)
  link_url   String?   @db.Text
  sort_order Int       @default(0)
  is_active  Boolean   @default(true)
  starts_at  DateTime? @db.Timestamptz(6)
  ends_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  @@index([is_active, sort_order], map: "idx_banners_active_sort")
  @@map("banners")
}

model Product {
  id                     String                @id(map: "products_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category_id            String                @db.Uuid
  name_en                String                @db.VarChar(200)
  name_ar                String                @db.VarChar(200)
  description            String?               @db.Text
  price                  Decimal               @default(0) @db.Decimal(12, 2)
  /// Discount definition only; on_sale, discounted_price, effective_price and
  /// discount_percent are derived at read time, never stored.
  discount_type          String?               @db.VarChar(10)
  discount_value         Decimal?              @db.Decimal(12, 2)
  discount_starts_at     DateTime?             @db.Timestamptz(6)
  discount_ends_at       DateTime?             @db.Timestamptz(6)
  is_negotiable          Boolean               @default(false)
  floor_price            Decimal?              @db.Decimal(12, 2)
  points_price           Int?
  tracks_expiry          Boolean               @default(false)
  rating_avg             Decimal               @default(0) @db.Decimal(3, 2)
  status                 String                @default("active") @db.VarChar(20)
  created_at             DateTime              @default(now()) @db.Timestamptz(6)
  updated_at             DateTime              @default(now()) @db.Timestamptz(6)
  category               Category              @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "products_category_id_fkey")
  variants               ProductVariant[]
  images                 ProductImage[]
  purchase_invoice_items PurchaseInvoiceItem[]
  inventory_batches      InventoryBatch[]
  cart_items             CartItem[]
  wishlist_items         WishlistItem[]
  order_items            OrderItem[]
  product_reviews        ProductReview[]

  @@index([category_id], map: "idx_products_category")
  @@index([status], map: "idx_products_status")
  // idx_products_discount_window backs GET /products?on_sale=true. It is a
  // partial index (WHERE discount_type IS NOT NULL) in infra/db/schema.sql,
  // which Prisma cannot express, so it is deliberately not declared here.
  @@map("products")
}

model ProductVariant {
  id                     String                @id(map: "product_variants_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id             String                @db.Uuid
  sku                    String                @unique(map: "product_variants_sku_key") @db.VarChar(80)
  attributes             Json?                 @db.JsonB
  price_delta            Decimal               @default(0) @db.Decimal(12, 2)
  product                Product               @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_variants_product_id_fkey")
  purchase_invoice_items PurchaseInvoiceItem[]
  inventory_batches      InventoryBatch[]
  cart_items             CartItem[]
  order_items            OrderItem[]

  @@map("product_variants")
}

model ProductImage {
  id         String  @id(map: "product_images_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String  @db.Uuid
  url        String  @db.VarChar(400)
  sort_order Int     @default(0)
  product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_images_product_id_fkey")

  @@unique([product_id, sort_order], map: "product_images_product_id_sort_order_key")
  @@map("product_images")
}

model Supplier {
  id                String            @id(map: "suppliers_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String            @db.VarChar(160)
  phone             String?           @db.VarChar(32)
  email             String?           @db.VarChar(160)
  address           String?           @db.Text
  is_active         Boolean           @default(true)
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  purchase_invoices PurchaseInvoice[]
  inventory_batches InventoryBatch[]

  @@map("suppliers")
}

model PurchaseInvoice {
  id             String                @id(map: "purchase_invoices_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplier_id    String                @db.Uuid
  invoice_number String?               @db.VarChar(80)
  total_cost     Decimal               @default(0) @db.Decimal(14, 2)
  status         String                @default("draft") @db.VarChar(20)
  received_at    DateTime?             @db.Timestamptz(6)
  created_by     String?               @db.Uuid
  created_at     DateTime              @default(now()) @db.Timestamptz(6)
  supplier       Supplier              @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "purchase_invoices_supplier_id_fkey")
  creator        User?                 @relation("PurchaseInvoiceCreatedBy", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "purchase_invoices_created_by_fkey")
  items          PurchaseInvoiceItem[]

  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id                String           @id(map: "purchase_invoice_items_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoice_id        String           @db.Uuid
  product_id        String           @db.Uuid
  variant_id        String?          @db.Uuid
  quantity          Int
  unit_cost         Decimal          @db.Decimal(12, 2)
  lot_number        String?          @db.VarChar(80)
  expiry_date       DateTime?        @db.Date
  invoice           PurchaseInvoice  @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "purchase_invoice_items_invoice_id_fkey")
  product           Product          @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "purchase_invoice_items_product_id_fkey")
  variant           ProductVariant?  @relation(fields: [variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "purchase_invoice_items_variant_id_fkey")
  inventory_batches InventoryBatch[]

  @@map("purchase_invoice_items")
}

model Warehouse {
  id        String              @id(map: "warehouses_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String              @db.VarChar(120)
  code      String              @unique(map: "warehouses_code_key") @db.VarChar(40)
  is_active Boolean             @default(true)
  locations WarehouseLocation[]

  @@map("warehouses")
}

model WarehouseLocation {
  id                 String             @id(map: "warehouse_locations_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouse_id       String             @db.Uuid
  zone               String?            @db.VarChar(40)
  aisle              String?            @db.VarChar(40)
  shelf              String?            @db.VarChar(40)
  bin                String?            @db.VarChar(40)
  warehouse          Warehouse          @relation(fields: [warehouse_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "warehouse_locations_warehouse_id_fkey")
  batch_stock        BatchStock[]
  movements_from     StockMovement[]    @relation("StockMovementFromLocation")
  movements_to       StockMovement[]    @relation("StockMovementToLocation")
  stock_reservations StockReservation[]
  pick_list_items    PickListItem[]

  @@unique([warehouse_id, zone, aisle, shelf, bin], map: "warehouse_locations_warehouse_id_zone_aisle_shelf_bin_key")
  @@map("warehouse_locations")
}

model InventoryBatch {
  id                    String               @id(map: "inventory_batches_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id            String               @db.Uuid
  variant_id            String?              @db.Uuid
  supplier_id           String?              @db.Uuid
  po_item_id            String?              @db.Uuid
  lot_number            String?              @db.VarChar(80)
  expiry_date           DateTime?            @db.Date
  purchase_cost         Decimal              @db.Decimal(12, 2)
  qty_received          Int
  entry_date            DateTime             @default(now()) @db.Timestamptz(6)
  product               Product              @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "inventory_batches_product_id_fkey")
  variant               ProductVariant?      @relation(fields: [variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "inventory_batches_variant_id_fkey")
  supplier              Supplier?            @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "inventory_batches_supplier_id_fkey")
  purchase_invoice_item PurchaseInvoiceItem? @relation(fields: [po_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "inventory_batches_po_item_id_fkey")
  batch_stock           BatchStock[]
  stock_movements       StockMovement[]
  stock_reservations    StockReservation[]
  pick_list_items       PickListItem[]
  return_items          ReturnItem[]

  @@index([product_id], map: "idx_batches_product")
  @@index([expiry_date], map: "idx_batches_expiry")
  @@map("inventory_batches")
}

model BatchStock {
  id          String            @id(map: "batch_stock_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_id    String            @db.Uuid
  location_id String            @db.Uuid
  quantity    Int               @default(0)
  batch       InventoryBatch    @relation(fields: [batch_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "batch_stock_batch_id_fkey")
  location    WarehouseLocation @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "batch_stock_location_id_fkey")

  @@unique([batch_id, location_id], map: "batch_stock_batch_id_location_id_key")
  @@index([batch_id], map: "idx_batch_stock_batch")
  @@index([location_id], map: "idx_batch_stock_location")
  @@map("batch_stock")
}

model StockMovement {
  id            String             @id(map: "stock_movements_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_id      String             @db.Uuid
  type          String             @db.VarChar(20)
  from_location String?            @db.Uuid
  to_location   String?            @db.Uuid
  quantity      Int
  reference     String?            @db.VarChar(120)
  user_id       String?            @db.Uuid
  created_at    DateTime           @default(now()) @db.Timestamptz(6)
  batch         InventoryBatch     @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "stock_movements_batch_id_fkey")
  source        WarehouseLocation? @relation("StockMovementFromLocation", fields: [from_location], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "stock_movements_from_location_fkey")
  destination   WarehouseLocation? @relation("StockMovementToLocation", fields: [to_location], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "stock_movements_to_location_fkey")
  user          User?              @relation("StockMovementUser", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "stock_movements_user_id_fkey")

  @@index([batch_id], map: "idx_movements_batch")
  @@index([type], map: "idx_movements_type")
  @@map("stock_movements")
}

model Cart {
  id         String     @id(map: "carts_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String     @unique(map: "carts_user_id_key") @db.Uuid
  coupon_id  String?    @db.Uuid
  updated_at DateTime   @default(now()) @db.Timestamptz(6)
  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "carts_user_id_fkey")
  coupon     Coupon?    @relation(fields: [coupon_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "carts_coupon_id_fkey")
  items      CartItem[]

  @@map("carts")
}

model CartItem {
  id         String          @id(map: "cart_items_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cart_id    String          @db.Uuid
  product_id String          @db.Uuid
  variant_id String?         @db.Uuid
  quantity   Int
  unit_price Decimal         @db.Decimal(12, 2)
  cart       Cart            @relation(fields: [cart_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cart_items_cart_id_fkey")
  product    Product         @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cart_items_product_id_fkey")
  variant    ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cart_items_variant_id_fkey")

  @@map("cart_items")
}

model WishlistItem {
  id         String   @id(map: "wishlist_items_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  product_id String   @db.Uuid
  added_at   DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "wishlist_items_user_id_fkey")
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "wishlist_items_product_id_fkey")

  @@unique([user_id, product_id], map: "wishlist_items_user_id_product_id_key")
  @@map("wishlist_items")
}

model Coupon {
  id          String    @id(map: "coupons_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String    @unique(map: "coupons_code_key") @db.VarChar(60)
  type        String    @db.VarChar(20)
  value       Decimal   @db.Decimal(12, 2)
  usage_limit Int?
  used_count  Int       @default(0)
  expires_at  DateTime? @db.Timestamptz(6)
  orders      Order[]
  carts       Cart[]

  @@map("coupons")
}

model Order {
  id                     String             @id(map: "orders_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                String             @db.Uuid
  address_id             String?            @db.Uuid
  delivery_id            String?            @unique(map: "orders_delivery_id_key") @db.Uuid
  coupon_id              String?            @db.Uuid
  order_number           String             @unique(map: "orders_order_number_key") @db.VarChar(40)
  status                 String             @default("pending") @db.VarChar(30)
  payment_method         String             @default("cod") @db.VarChar(20)
  subtotal               Decimal            @default(0) @db.Decimal(12, 2)
  delivery_fee           Decimal            @default(0) @db.Decimal(12, 2)
  discount               Decimal            @default(0) @db.Decimal(12, 2)
  total                  Decimal            @default(0) @db.Decimal(12, 2)
  delivery_contact_phone String             @db.VarChar(32)
  delivery_address_label String?            @db.VarChar(80)
  delivery_city          String             @db.VarChar(80)
  delivery_area          String?            @db.VarChar(120)
  delivery_street        String?            @db.VarChar(160)
  delivery_details       String?            @db.Text
  delivery_lat           Float?             @db.DoublePrecision
  delivery_lng           Float?             @db.DoublePrecision
  placed_at              DateTime           @default(now()) @db.Timestamptz(6)
  user                   User               @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "orders_user_id_fkey")
  address                Address?           @relation(fields: [address_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "orders_address_id_fkey")
  delivery               Delivery?          @relation("OrderCurrentDelivery", fields: [delivery_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "orders_delivery_id_fkey")
  coupon                 Coupon?            @relation(fields: [coupon_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "orders_coupon_id_fkey")
  items                  OrderItem[]
  payments               Payment[]
  stock_reservations     StockReservation[]
  pick_lists             PickList[]
  deliveries             Delivery[]         @relation("OrderDeliveryHistory")
  returns                Return[]
  loyalty_ledger         LoyaltyLedger[]

  @@index([user_id], map: "idx_orders_user")
  @@index([status], map: "idx_orders_status")
  @@map("orders")
}

model OrderItem {
  id                 String             @id(map: "order_items_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id           String             @db.Uuid
  product_id         String             @db.Uuid
  variant_id         String?            @db.Uuid
  product_name_ar    String             @db.VarChar(200)
  product_name_en    String             @db.VarChar(200)
  image_url          String?            @db.VarChar(400)
  quantity           Int
  unit_price         Decimal            @db.Decimal(12, 2)
  line_total         Decimal            @db.Decimal(12, 2)
  order              Order              @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "order_items_order_id_fkey")
  product            Product            @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "order_items_product_id_fkey")
  variant            ProductVariant?    @relation(fields: [variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "order_items_variant_id_fkey")
  stock_reservations StockReservation[]
  pick_list_items    PickListItem[]
  return_items       ReturnItem[]
  product_reviews    ProductReview[]

  @@index([order_id], map: "idx_order_items_order")
  @@map("order_items")
}

model Payment {
  id       String    @id(map: "payments_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id String    @db.Uuid
  method   String    @default("cod") @db.VarChar(20)
  status   String    @default("pending") @db.VarChar(20)
  amount   Decimal   @db.Decimal(12, 2)
  paid_at  DateTime? @db.Timestamptz(6)
  order    Order     @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "payments_order_id_fkey")

  @@map("payments")
}

model StockReservation {
  id            String            @id(map: "stock_reservations_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id      String            @db.Uuid
  order_item_id String?           @db.Uuid
  batch_id      String            @db.Uuid
  location_id   String            @db.Uuid
  quantity      Int
  status        String            @default("reserved") @db.VarChar(20)
  created_at    DateTime          @default(now()) @db.Timestamptz(6)
  order         Order             @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "stock_reservations_order_id_fkey")
  order_item    OrderItem?        @relation(fields: [order_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "stock_reservations_order_item_id_fkey")
  batch         InventoryBatch    @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "stock_reservations_batch_id_fkey")
  location      WarehouseLocation @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "stock_reservations_location_id_fkey")

  @@index([order_id], map: "idx_reservations_order")
  @@map("stock_reservations")
}

model PickList {
  id          String         @id(map: "pick_lists_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id    String         @db.Uuid
  assigned_to String?        @db.Uuid
  status      String         @default("open") @db.VarChar(20)
  created_at  DateTime       @default(now()) @db.Timestamptz(6)
  order       Order          @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "pick_lists_order_id_fkey")
  assignee    User?          @relation("PickListAssignee", fields: [assigned_to], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "pick_lists_assigned_to_fkey")
  items       PickListItem[]

  @@map("pick_lists")
}

model PickListItem {
  id            String            @id(map: "pick_list_items_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pick_list_id  String            @db.Uuid
  order_item_id String?           @db.Uuid
  batch_id      String            @db.Uuid
  location_id   String            @db.Uuid
  quantity      Int
  picked        Boolean           @default(false)
  pick_list     PickList          @relation(fields: [pick_list_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "pick_list_items_pick_list_id_fkey")
  order_item    OrderItem?        @relation(fields: [order_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "pick_list_items_order_item_id_fkey")
  batch         InventoryBatch    @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "pick_list_items_batch_id_fkey")
  location      WarehouseLocation @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "pick_list_items_location_id_fkey")

  @@map("pick_list_items")
}

model Delivery {
  id                String           @id(map: "deliveries_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id          String           @db.Uuid
  agent_id          String?          @db.Uuid
  status            String           @default("assigned") @db.VarChar(30)
  delivery_fee      Decimal          @default(0) @db.Decimal(12, 2)
  dispatched_at     DateTime?        @db.Timestamptz(6)
  delivered_at      DateTime?        @db.Timestamptz(6)
  order             Order            @relation("OrderDeliveryHistory", fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "deliveries_order_id_fkey")
  current_for_order Order?           @relation("OrderCurrentDelivery")
  agent             User?            @relation("DeliveryAgent", fields: [agent_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "deliveries_agent_id_fkey")
  ratings           DeliveryRating[]

  @@map("deliveries")
}

model Return {
  id         String       @id(map: "returns_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id   String       @db.Uuid
  user_id    String       @db.Uuid
  type       String       @default("return") @db.VarChar(20)
  status     String       @default("requested") @db.VarChar(20)
  reason     String?      @db.Text
  created_at DateTime     @default(now()) @db.Timestamptz(6)
  order      Order        @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "returns_order_id_fkey")
  user       User         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "returns_user_id_fkey")
  items      ReturnItem[]

  @@index([order_id], map: "idx_returns_order")
  @@map("returns")
}

model ReturnItem {
  id            String          @id(map: "return_items_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  return_id     String          @db.Uuid
  order_item_id String          @db.Uuid
  quantity      Int
  condition     String          @db.VarChar(20)
  restock       Boolean         @default(false)
  batch_id      String?         @db.Uuid
  return        Return          @relation(fields: [return_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "return_items_return_id_fkey")
  order_item    OrderItem       @relation(fields: [order_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "return_items_order_item_id_fkey")
  batch         InventoryBatch? @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "return_items_batch_id_fkey")

  @@map("return_items")
}

model ProductReview {
  id                String     @id(map: "product_reviews_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id        String     @db.Uuid
  user_id           String     @db.Uuid
  order_item_id     String?    @db.Uuid
  rating            Int
  comment           String?    @db.Text
  verified_purchase Boolean    @default(false)
  status            String     @default("pending") @db.VarChar(20)
  created_at        DateTime   @default(now()) @db.Timestamptz(6)
  product           Product    @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_reviews_product_id_fkey")
  user              User       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "product_reviews_user_id_fkey")
  order_item        OrderItem? @relation(fields: [order_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "product_reviews_order_item_id_fkey")

  @@unique([order_item_id, user_id], map: "product_reviews_order_item_id_user_id_key")
  @@map("product_reviews")
}

model DeliveryRating {
  id          String   @id(map: "delivery_ratings_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  delivery_id String   @db.Uuid
  agent_id    String?  @db.Uuid
  user_id     String   @db.Uuid
  stars       Int
  comment     String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  delivery    Delivery @relation(fields: [delivery_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "delivery_ratings_delivery_id_fkey")
  agent       User?    @relation("DeliveryRatingAgent", fields: [agent_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "delivery_ratings_agent_id_fkey")
  user        User     @relation("DeliveryRatingUser", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "delivery_ratings_user_id_fkey")

  @@unique([delivery_id, user_id], map: "delivery_ratings_delivery_id_user_id_key")
  @@map("delivery_ratings")
}

model LoyaltyAccount {
  id             String          @id(map: "loyalty_accounts_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String          @unique(map: "loyalty_accounts_user_id_key") @db.Uuid
  points_balance Int             @default(0)
  user           User            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "loyalty_accounts_user_id_fkey")
  ledger         LoyaltyLedger[]

  @@map("loyalty_accounts")
}

model LoyaltyLedger {
  id         String         @id(map: "loyalty_ledger_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id String         @db.Uuid
  order_id   String?        @db.Uuid
  type       String         @db.VarChar(20)
  points     Int
  note       String?        @db.VarChar(255)
  created_at DateTime       @default(now()) @db.Timestamptz(6)
  account    LoyaltyAccount @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "loyalty_ledger_account_id_fkey")
  order      Order?         @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "loyalty_ledger_order_id_fkey")

  @@index([account_id], map: "idx_loyalty_ledger_account")
  @@map("loyalty_ledger")
}

model AuditLog {
  id          String   @id(map: "audit_logs_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_id    String?  @db.Uuid
  action      String   @db.VarChar(80)
  entity_type String   @db.VarChar(80)
  entity_id   String?  @db.Uuid
  before      Json?    @db.JsonB
  after       Json?    @db.JsonB
  ip          String?  @db.VarChar(64)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  actor       User?    @relation("AuditActor", fields: [actor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "audit_logs_actor_id_fkey")

  @@index([entity_type, entity_id], map: "idx_audit_entity")
  @@map("audit_logs")
}
