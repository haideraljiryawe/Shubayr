// Runtime database model. Prisma Migrate files are the authoritative upgrade
// path; ../../infra/db/schema.sql is a synchronized bootstrap/reference.
// PostgreSQL CHECK constraints and partial indexes that Prisma cannot express
// are retained explicitly in migrations and schema.sql.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Monetary values use exact NUMERIC storage. Customer-facing amounts are
// rounded at the configured currency precision; costs and FX rates retain
// additional internal precision.

model StoreSetting {
  id         String   @id(map: "store_settings_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key        String   @unique(map: "store_settings_key_key") @db.VarChar(120)
  value      String?  @db.Text
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("store_settings")
}

model Currency {
  code               String           @id(map: "currencies_pkey") @db.Char(3)
  name_ar            String           @db.VarChar(120)
  name_en            String           @db.VarChar(120)
  symbol             String           @db.VarChar(20)
  display_precision  Int
  is_base            Boolean          @default(false)
  enabled            Boolean          @default(true)
  created_at         DateTime         @default(now()) @db.Timestamptz(6)
  updated_at         DateTime         @default(now()) @db.Timestamptz(6)
  exchange_rates     ExchangeRate[]
  reference_variants ProductVariant[] @relation("VariantReferenceCurrency")
  journal_lines      JournalLine[]
  cash_accounts      CashAccount[]

  @@map("currencies")
}

model ExchangeRate {
  id                String           @id(map: "exchange_rates_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  currency_code     String           @db.Char(3)
  rate              Decimal          @db.Decimal(24, 10)
  effective_at      DateTime         @db.Timestamptz(6)
  set_by            String           @db.Uuid
  reason            String           @db.VarChar(500)
  created_at        DateTime         @default(now()) @db.Timestamptz(6)
  currency          Currency         @relation(fields: [currency_code], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "exchange_rates_currency_code_fkey")
  awaiting_variants ProductVariant[] @relation("VariantAwaitingRate")
  price_versions    PriceVersion[]

  @@index([currency_code, effective_at(sort: Desc), id(sort: Desc)], map: "idx_exchange_rates_applicable")
  @@map("exchange_rates")
}

model DocumentSequence {
  document_type String @db.VarChar(40)
  year          Int
  prefix        String @db.VarChar(12)
  last_value    Int    @default(0)

  @@id([document_type, year], map: "document_sequences_pkey")
  @@map("document_sequences")
}

model OperationRecord {
  id              String    @id(map: "operation_records_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String    @db.Uuid
  operation_id    String    @db.VarChar(128)
  endpoint        String    @db.VarChar(160)
  payload_hash    String    @db.Char(64)
  status          String    @default("processing") @db.VarChar(20)
  response_status Int?
  response        Json?     @db.JsonB
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  completed_at    DateTime? @db.Timestamptz(6)

  @@unique([user_id, operation_id], map: "operation_records_user_id_operation_id_key")
  @@map("operation_records")
}

model DocumentDraft {
  id            String   @id(map: "document_drafts_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  document_type String   @db.VarChar(60)
  payload       Json     @db.JsonB
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  @@unique([user_id, document_type], map: "document_drafts_user_id_document_type_key")
  @@index([user_id, updated_at(sort: Desc)], map: "idx_document_drafts_user")
  @@map("document_drafts")
}

model LedgerAccount {
  id            String        @id(map: "ledger_accounts_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String        @unique(map: "ledger_accounts_code_key") @db.VarChar(40)
  name_ar       String        @db.VarChar(160)
  name_en       String        @db.VarChar(160)
  type          String        @db.VarChar(24)
  normal_side   String        @db.VarChar(6)
  is_system     Boolean       @default(true)
  enabled       Boolean       @default(true)
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  journal_lines JournalLine[]
  cash_account  CashAccount?

  @@map("ledger_accounts")
}

model JournalEntry {
  id                String               @id(map: "journal_entries_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_number   String               @unique(map: "journal_entries_document_number_key") @db.VarChar(40)
  source_type       String               @db.VarChar(60)
  source_id         String               @db.Uuid
  event             String               @db.VarChar(60)
  document_date     DateTime             @db.Date
  accounting_date   DateTime             @db.Date
  description       String?              @db.VarChar(500)
  created_by        String               @db.Uuid
  posted_at         DateTime             @default(now()) @db.Timestamptz(6)
  reverses_id       String?              @unique(map: "journal_entries_reverses_id_key") @db.Uuid
  reverses          JournalEntry?        @relation("JournalReversals", fields: [reverses_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "journal_entries_reverses_id_fkey")
  reversals         JournalEntry[]       @relation("JournalReversals")
  lines             JournalLine[]
  cash_transfers    CashTransfer[]
  opening_balances  CashOpeningBalance[]
  inventory_opening InventoryOpening?
  stock_count       StockCount?
  write_down        InventoryWriteDown?

  @@unique([source_type, source_id, event], map: "journal_entries_source_event_key")
  @@index([accounting_date, id], map: "idx_journal_entries_accounting_date")
  @@index([source_type, source_id], map: "idx_journal_entries_source")
  @@map("journal_entries")
}

model JournalLine {
  id              String        @id(map: "journal_lines_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entry_id        String        @db.Uuid
  account_id      String        @db.Uuid
  debit_base      Decimal       @default(0) @db.Decimal(20, 4)
  credit_base     Decimal       @default(0) @db.Decimal(20, 4)
  currency_code   String        @db.Char(3)
  original_amount Decimal       @db.Decimal(20, 6)
  exchange_rate   Decimal       @db.Decimal(24, 10)
  memo            String?       @db.VarChar(500)
  entry           JournalEntry  @relation(fields: [entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "journal_lines_entry_id_fkey")
  account         LedgerAccount @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "journal_lines_account_id_fkey")
  currency        Currency      @relation(fields: [currency_code], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "journal_lines_currency_code_fkey")

  @@index([account_id, entry_id], map: "idx_journal_lines_account")
  @@map("journal_lines")
}

model CashAccount {
  id                String               @id(map: "cash_accounts_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String               @db.VarChar(160)
  kind              String               @db.VarChar(12)
  currency_code     String               @db.Char(3)
  ledger_account_id String               @unique(map: "cash_accounts_ledger_account_id_key") @db.Uuid
  is_active         Boolean              @default(true)
  created_at        DateTime             @default(now()) @db.Timestamptz(6)
  updated_at        DateTime             @default(now()) @db.Timestamptz(6)
  currency          Currency             @relation(fields: [currency_code], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "cash_accounts_currency_code_fkey")
  ledger_account    LedgerAccount        @relation(fields: [ledger_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cash_accounts_ledger_account_id_fkey")
  transfers_from    CashTransfer[]       @relation("CashTransferFrom")
  transfers_to      CashTransfer[]       @relation("CashTransferTo")
  opening_balances  CashOpeningBalance[]

  @@map("cash_accounts")
}

model CashOpeningBalance {
  id               String       @id(map: "cash_opening_balances_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_number  String       @unique(map: "cash_opening_balances_document_number_key") @db.VarChar(40)
  cash_account_id  String       @db.Uuid
  amount           Decimal      @db.Decimal(20, 6)
  currency_code    String       @db.Char(3)
  document_date    DateTime     @db.Date
  accounting_date  DateTime     @db.Date
  backdate_reason  String?      @db.VarChar(500)
  created_by       String       @db.Uuid
  journal_entry_id String       @unique(map: "cash_opening_balances_journal_entry_id_key") @db.Uuid
  created_at       DateTime     @default(now()) @db.Timestamptz(6)
  cash_account     CashAccount  @relation(fields: [cash_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cash_opening_balances_cash_account_id_fkey")
  journal_entry    JournalEntry @relation(fields: [journal_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cash_opening_balances_journal_entry_id_fkey")

  @@map("cash_opening_balances")
}

model CashTransfer {
  id               String       @id(map: "cash_transfers_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_number  String       @unique(map: "cash_transfers_document_number_key") @db.VarChar(40)
  from_account_id  String       @db.Uuid
  to_account_id    String       @db.Uuid
  amount           Decimal      @db.Decimal(20, 6)
  currency_code    String       @db.Char(3)
  document_date    DateTime     @db.Date
  accounting_date  DateTime     @db.Date
  backdate_reason  String?      @db.VarChar(500)
  reason           String       @db.VarChar(500)
  created_by       String       @db.Uuid
  journal_entry_id String       @unique(map: "cash_transfers_journal_entry_id_key") @db.Uuid
  created_at       DateTime     @default(now()) @db.Timestamptz(6)
  from_account     CashAccount  @relation("CashTransferFrom", fields: [from_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cash_transfers_from_account_id_fkey")
  to_account       CashAccount  @relation("CashTransferTo", fields: [to_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cash_transfers_to_account_id_fkey")
  journal_entry    JournalEntry @relation(fields: [journal_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cash_transfers_journal_entry_id_fkey")

  @@map("cash_transfers")
}

model AccountingPeriod {
  month         DateTime      @id(map: "accounting_periods_pkey") @db.Date
  status        String        @default("open") @db.VarChar(12)
  closed_at     DateTime?     @db.Timestamptz(6)
  closed_by     String?       @db.Uuid
  reopened_at   DateTime?     @db.Timestamptz(6)
  reopened_by   String?       @db.Uuid
  reopen_reason String?       @db.VarChar(500)
  closes        PeriodClose[]

  @@map("accounting_periods")
}

model PeriodClose {
  id           String           @id(map: "period_closes_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  period_month DateTime         @db.Date
  sequence     Int
  snapshot     Json             @db.JsonB
  differences  Json?            @db.JsonB
  reason       String?          @db.VarChar(500)
  closed_by    String           @db.Uuid
  created_at   DateTime         @default(now()) @db.Timestamptz(6)
  period       AccountingPeriod @relation(fields: [period_month], references: [month], onDelete: NoAction, onUpdate: NoAction, map: "period_closes_period_month_fkey")

  @@unique([period_month, sequence], map: "period_closes_period_sequence_key")
  @@map("period_closes")
}

model BusinessHour {
  weekday    Int      @id(map: "business_hours_pkey")
  opens_at   String?  @db.Char(5)
  closes_at  String?  @db.Char(5)
  is_closed  Boolean  @default(false)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("business_hours")
}

model ClosedDay {
  date       DateTime @id(map: "closed_days_pkey") @db.Date
  reason     String?  @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("closed_days")
}

model ProtectionThreshold {
  key        String   @id(map: "protection_thresholds_pkey") @db.VarChar(40)
  percent    Decimal  @db.Decimal(7, 2)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("protection_thresholds")
}

model Role {
  id               String           @id(map: "roles_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String           @unique(map: "roles_name_key") @db.VarChar(80)
  description      String?          @db.VarChar(255)
  is_system        Boolean          @default(false)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  role_permissions RolePermission[]
  users            User[]

  @@map("roles")
}

model Permission {
  id                 String                @id(map: "permissions_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                String                @unique(map: "permissions_key_key") @db.VarChar(120)
  group              String                @db.VarChar(80)
  description        String?               @db.VarChar(255)
  role_permissions   RolePermission[]
  preset_permissions PresetPermission[]
  user_grants        UserPermissionGrant[]

  @@map("permissions")
}

model RolePermission {
  role_id       String     @db.Uuid
  permission_id String     @db.Uuid
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_permissions_role_id_fkey")
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_permissions_permission_id_fkey")

  @@id([role_id, permission_id], map: "role_permissions_pkey")
  @@map("role_permissions")
}

model User {
  id                          String                          @id(map: "users_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_id                     String?                         @db.Uuid
  name                        String?                         @db.VarChar(120)
  phone                       String?                         @unique(map: "users_phone_key") @db.VarChar(32)
  username                    String?                         @unique(map: "users_username_key") @db.VarChar(80)
  email                       String?                         @db.VarChar(160)
  password_hash               String?                         @db.VarChar(255)
  must_change_password        Boolean                         @default(false)
  failed_login_attempts       Int                             @default(0)
  locked_until                DateTime?                       @db.Timestamptz(6)
  session_version             Int                             @default(1)
  permission_version          Int                             @default(1)
  is_active                   Boolean                         @default(true)
  created_at                  DateTime                        @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime                        @default(now()) @db.Timestamptz(6)
  role                        Role?                           @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "users_role_id_fkey")
  work_profile                WorkProfile?
  permission_presets          UserPreset[]                    @relation("UserAccessPresets")
  assigned_permission_presets UserPreset[]                    @relation("UserAccessPresetActors")
  permission_grants           UserPermissionGrant[]           @relation("UserAccessGrants")
  assigned_permission_grants  UserPermissionGrant[]           @relation("UserAccessGrantActors")
  addresses                   Address[]
  purchase_invoices           PurchaseInvoice[]               @relation("PurchaseInvoiceCreatedBy")
  stock_movements             StockMovement[]                 @relation("StockMovementUser")
  custody_stock_movements     StockMovement[]                 @relation("StockMovementCustodyParty")
  inventory_openings          InventoryOpening[]              @relation("InventoryOpeningCreator")
  stock_transfers             StockTransfer[]                 @relation("StockTransferCreator")
  stock_counts                StockCount[]                    @relation("StockCountCreator")
  approved_stock_counts       StockCount[]                    @relation("StockCountApprover")
  inventory_write_downs       InventoryWriteDown[]            @relation("InventoryWriteDownCreator")
  custody_holdings            CustodyHolding[]                @relation("CustodyParty")
  cart                        Cart?
  wishlist_items              WishlistItem[]
  orders                      Order[]
  assigned_pick_lists         PickList[]                      @relation("PickListAssignee")
  assigned_deliveries         Delivery[]                      @relation("DeliveryAgent")
  returns                     Return[]
  reviewed_returns            Return[]                        @relation("ReturnReviewer")
  refund_ledger_entries       RefundLedgerEntry[]             @relation("RefundCreator")
  product_reviews             ProductReview[]
  moderated_product_reviews   ProductReview[]                 @relation("ProductReviewModerator")
  delivery_ratings_as_agent   DeliveryRating[]                @relation("DeliveryRatingAgent")
  delivery_ratings_as_user    DeliveryRating[]                @relation("DeliveryRatingUser")
  loyalty_account             LoyaltyAccount?
  created_loyalty_entries     LoyaltyLedger[]                 @relation("LoyaltyLedgerCreator")
  audit_logs                  AuditLog[]                      @relation("AuditActor")
  device_tokens               DeviceToken[]
  notification_preferences    NotificationPreference?
  notification_channels       NotificationChannelPreference[]
  notification_events         NotificationEvent[]
  notification_logs           NotificationLog[]
  notification_stream_events  NotificationStreamEvent[]
  refresh_tokens              RefreshToken[]
  uploaded_media              MediaObject[]                   @relation("MediaUploadedBy")

  @@map("users")
}

model OtpCode {
  id          String    @id(map: "otp_codes_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone       String    @db.VarChar(32)
  code_hash   String    @db.VarChar(255)
  expires_at  DateTime  @db.Timestamptz(6)
  consumed_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([phone, consumed_at, created_at], map: "idx_otp_codes_phone_active")
  @@map("otp_codes")
}

model RefreshToken {
  id              String    @id(map: "refresh_tokens_pkey") @db.Uuid
  user_id         String    @db.Uuid
  token_hash      String    @unique(map: "refresh_tokens_token_hash_key") @db.VarChar(64)
  surface         String    @db.VarChar(16)
  client          String?   @db.VarChar(20)
  session_version Int
  expires_at      DateTime  @db.Timestamptz(6)
  revoked_at      DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  user            User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "refresh_tokens_user_id_fkey")

  @@index([user_id], map: "idx_refresh_tokens_user")
  @@index([expires_at], map: "idx_refresh_tokens_expiry")
  @@map("refresh_tokens")
}

model PermissionPreset {
  id          String             @id(map: "permission_presets_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String             @unique(map: "permission_presets_name_key") @db.VarChar(80)
  description String?            @db.VarChar(255)
  is_system   Boolean            @default(false)
  created_at  DateTime           @default(now()) @db.Timestamptz(6)
  updated_at  DateTime           @default(now()) @db.Timestamptz(6)
  permissions PresetPermission[]
  users       UserPreset[]

  @@map("permission_presets")
}

model PresetPermission {
  preset_id     String           @db.Uuid
  permission_id String           @db.Uuid
  preset        PermissionPreset @relation(fields: [preset_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "preset_permissions_preset_id_fkey")
  permission    Permission       @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "preset_permissions_permission_id_fkey")

  @@id([preset_id, permission_id], map: "preset_permissions_pkey")
  @@map("preset_permissions")
}

model UserPreset {
  user_id     String           @db.Uuid
  preset_id   String           @db.Uuid
  assigned_by String           @db.Uuid
  reason      String           @db.VarChar(500)
  created_at  DateTime         @default(now()) @db.Timestamptz(6)
  user        User             @relation("UserAccessPresets", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_presets_user_id_fkey")
  preset      PermissionPreset @relation(fields: [preset_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_presets_preset_id_fkey")
  actor       User             @relation("UserAccessPresetActors", fields: [assigned_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_presets_assigned_by_fkey")

  @@id([user_id, preset_id], map: "user_presets_pkey")
  @@map("user_presets")
}

model UserPermissionGrant {
  user_id       String     @db.Uuid
  permission_id String     @db.Uuid
  granted_by    String     @db.Uuid
  reason        String     @db.VarChar(500)
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  user          User       @relation("UserAccessGrants", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_permission_grants_user_id_fkey")
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_permission_grants_permission_id_fkey")
  actor         User       @relation("UserAccessGrantActors", fields: [granted_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_permission_grants_granted_by_fkey")

  @@id([user_id, permission_id], map: "user_permission_grants_pkey")
  @@map("user_permission_grants")
}

model WorkProfile {
  id         String   @id(map: "work_profiles_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @unique(map: "work_profiles_user_id_key") @db.Uuid
  name       String   @db.VarChar(120)
  app_role   String   @db.VarChar(32)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "work_profiles_user_id_fkey")

  @@map("work_profiles")
}

model MediaObject {
  id          String   @id(map: "media_objects_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  object_key  String   @unique(map: "media_objects_object_key_key") @db.VarChar(512)
  public_url  String   @unique(map: "media_objects_public_url_key") @db.Text
  mime_type   String   @db.VarChar(80)
  size_bytes  Int
  checksum    String   @db.VarChar(64)
  uploaded_by String?  @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  uploader    User?    @relation("MediaUploadedBy", fields: [uploaded_by], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "media_objects_uploaded_by_fkey")

  @@index([uploaded_by], map: "idx_media_objects_uploader")
  @@map("media_objects")
}

model Address {
  id            String   @id(map: "addresses_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  label         String?  @db.VarChar(80)
  city          String   @db.VarChar(80)
  area          String?  @db.VarChar(120)
  street        String?  @db.VarChar(160)
  details       String?  @db.Text
  contact_phone String   @db.VarChar(32)
  lat           Float?   @db.DoublePrecision
  lng           Float?   @db.DoublePrecision
  is_default    Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "addresses_user_id_fkey")
  orders        Order[]

  @@map("addresses")
}

model DeviceToken {
  id             String    @id(map: "device_tokens_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String    @db.Uuid
  token          String    @db.VarChar(512)
  platform       String    @db.VarChar(16)
