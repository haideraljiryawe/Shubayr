# The API the admin's server talks to. Server-side only: the browser never
# calls the API directly — every call goes through this app's /api routes.
API_URL=http://localhost:8000/api/v1

# The public origin this admin is served from. State-changing /api requests
# must carry this Origin (CSRF defence on top of SameSite=Strict cookies).
ADMIN_ORIGIN=http://localhost:3200

# Session cookies are always httpOnly + SameSite=Strict, and Secure by
# default. Browsers accept Secure cookies on http://localhost; set this to
# false only for plain-HTTP access on another host during development.
ADMIN_COOKIE_SECURE=true
