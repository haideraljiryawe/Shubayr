flowchart TB
  subgraph Clients["Client Layer"]
    MA["Mobile App<br/>(Flutter · iOS & Android)"]
    WEB["Web Storefront<br/>(Next.js · SSR/SEO)"]
    ADM["Admin Dashboard<br/>(Flutter Web)"]
  end
  subgraph Edge["Edge / Delivery"]
    CDN["CDN + Image Optimization"]
    LB["Nginx · Load Balancer / TLS"]
  end
  subgraph AppLayer["Application Layer"]
    API["REST / JSON API<br/>(NestJS · TypeScript · Prisma)"]
    AUTH["Auth Service<br/>(JWT / Passport · OTP)"]
    QUEUE["Queue Workers<br/>(BullMQ · Redis)"]
  end
  subgraph DataLayer["Data Layer"]
    PG[("PostgreSQL<br/>Primary DB")]
    RED[("Redis<br/>Cache + Sessions")]
    SEARCH[("Meilisearch<br/>Product Search")]
    OBJ[("Object Storage<br/>Images / Media")]
  end
  subgraph External["External Services"]
    FCM["Firebase Cloud<br/>Messaging (Push)"]
    SMS["SMS / OTP Gateway"]
    PAY["Payment Module<br/>(COD now · gateways later)"]
    MAP["Maps / Geocoding"]
  end
