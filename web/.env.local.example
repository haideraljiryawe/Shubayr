# Base URL of the Shubayr REST API (see ../api/openapi.yaml). Required for a
# production build (no localhost fallback); see docs/deploy/web-and-admin.md.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# The store's public address, for canonical URLs, Open Graph, sitemap.xml and
# robots.txt. Required for a production build.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Which domains talk to the real API. The backend lands one slice at a time, so
# this is decided per domain rather than globally.
#
#   <list>  comma-separated domain names (see src/lib/data-source.ts)
#   all     every domain live
#   none    every domain mocked
#
# Unset defaults to what the backend serves today: auth, profile, catalog,
# banners, cart, checkout, orders and addresses.
NEXT_PUBLIC_LIVE_DOMAINS=auth,profile,catalog,banners,cart,checkout,orders,addresses

# Global override: "true" forces every domain back onto fixtures, whatever
# NEXT_PUBLIC_LIVE_DOMAINS says. The Playwright suite runs under this.
# NEXT_PUBLIC_USE_MOCKS=true
