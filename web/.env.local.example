# Base URL of the Shubayr REST API (see ../api/openapi.yaml, v4.5.0).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Which domains talk to the real API. The backend lands one slice at a time, so
# this is decided per domain rather than globally.
#
#   <list>  comma-separated domain names (see src/lib/data-source.ts)
#   all     every domain live
#   none    every domain mocked
#
# Unset defaults to slice 1: auth, profile, catalog, banners.
NEXT_PUBLIC_LIVE_DOMAINS=auth,profile,catalog,banners

# Global override: "true" forces every domain back onto fixtures, whatever
# NEXT_PUBLIC_LIVE_DOMAINS says. The Playwright suite runs under this.
# NEXT_PUBLIC_USE_MOCKS=true
