# =====================================================================
# Shubayr — production settings for docker-compose.prod.yml
#
#   deploy/scripts/generate-env.sh shubayr.iq ops@shubayr.iq
#     → writes .env.production with fresh random secrets (mode 600), or
#   cp .env.production.example .env.production && chmod 600 .env.production
#
# NEVER commit .env.production (it is git-ignored). Every CHANGE_ME must be
# replaced; the deploy scripts refuse to run while one is left.
# Generate secrets with:  openssl rand -hex 24   (JWT: openssl rand -hex 32)
# Full guide and go-live checklist: docs/deploy/production.md
# =====================================================================

# ------------------------------------------------------------ domains
# The store is served at https://SHUBAYR_DOMAIN, the Web Admin at
# https://admin.SHUBAYR_DOMAIN and the API at https://api.SHUBAYR_DOMAIN;
# https://www.SHUBAYR_DOMAIN redirects permanently to the store.
# Create the four DNS A (and AAAA) records before the first start.
SHUBAYR_DOMAIN=shop.example.com
# Let's Encrypt account e-mail (certificate expiry notices).
ACME_EMAIL=CHANGE_ME
# Empty = real certificates from Let's Encrypt (production).
# "tls internal" = Caddy's own local CA — for a test stack only.
CADDY_TLS=

# ------------------------------------------------------------ images
# Images are pulled as $SHUBAYR_REGISTRY/shubayr-{api,api-migrate,admin,web,backup}:$SHUBAYR_TAG
# (published by .github/workflows/release.yml for a git tag v*). deploy.sh
# updates SHUBAYR_TAG; set it by hand only for the first run.
SHUBAYR_REGISTRY=ghcr.io/haideraljiryawe
SHUBAYR_TAG=CHANGE_ME
# Compose project name (prefix of containers and volumes). Keep it stable.
COMPOSE_PROJECT_NAME=shubayr

# ------------------------------------------------------------ database (PostgreSQL 16)
POSTGRES_DB=shubayr
POSTGRES_USER=shubayr
POSTGRES_PASSWORD=CHANGE_ME

# ------------------------------------------------------------ Redis (queues, rate limits, notification stream)
REDIS_PASSWORD=CHANGE_ME

# ------------------------------------------------------------ process roles
# docker-compose.prod.yml pins `api` to HTTP-only and `worker` to jobs-only.
# Running the backend directly defaults to `all` for local development/tests.
# Do not set one shared PROCESS_ROLE here. The worker writes this readiness file
# after its processors and repeatable jobs have bootstrapped.
WORKER_HEALTH_FILE=/tmp/shubayr-worker-ready

# ------------------------------------------------------------ Meilisearch (product search)
# At least 16 characters (Meilisearch refuses less in production mode).
MEILI_MASTER_KEY=CHANGE_ME

# ------------------------------------------------------------ object storage (product pictures, S3-compatible)
# The bundled SeaweedFS takes these as its credentials; the API and the backups use them.
S3_BUCKET=shubayr-media
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
# Largest single picture upload, bytes (default 8 MiB).
MEDIA_MAX_BYTES=8388608

# ------------------------------------------------------------ API secrets
# Signing keys for access and refresh tokens: different, 32+ characters each.
# Changing them signs everyone out.
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ------------------------------------------------------------ the proxy chain
# Browser → Caddy (TLS) → store / admin / API. The store's server also calls
# the API through Caddy; the admin's server calls the API directly.
# Every hop that may pass on a visitor's address lives on the private Docker
# network EDGE_SUBNET, and only that range is trusted:
#   - Caddy believes X-Forwarded-For only from EDGE_SUBNET (deploy/caddy/Caddyfile)
#   - TRUSTED_PROXIES (API): who may tell the API the visitor's address
#   - TRUSTED_FRONT_PROXIES (store and admin): who may tell those servers
# Both default to EDGE_SUBNET. Change EDGE_SUBNET only if it collides with
# another network on the server; never put a public range in these lists.
EDGE_SUBNET=172.30.10.0/24
# TRUSTED_PROXIES=172.30.10.0/24
# TRUSTED_FRONT_PROXIES=172.30.10.0/24

# ------------------------------------------------------------ rate limits (per client, per route, per minute)
# Always on. Strict covers OTP, admin sign-in, checkout and cart writes.
RATE_LIMIT_CATALOG_PER_MINUTE=600
RATE_LIMIT_NORMAL_PER_MINUTE=120
RATE_LIMIT_STRICT_PER_MINUTE=30

# ------------------------------------------------------------ launch settings
# false until opening day: every store page shows the "opening soon" page
# (noindex), robots.txt shuts crawlers out; the API and the Web Admin work.
# Set to true (or remove) and restart the store to open:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d web
STORE_PUBLIC=false
# The owner's preview link while closed: https://SHUBAYR_DOMAIN/preview?t=<token>
# Generate with: openssl rand -hex 24   (change it to revoke every preview)
STORE_PREVIEW_TOKEN=CHANGE_ME
# Web Admin modules shown at launch (admin/src/lib/modules.ts); "all" shows everything.
# Restocking goes through purchasing (suppliers, invoices, payments), deliveries
# through the store's own delivery parties, and their cash comes in as cash
# receipts. External-driver trips (trips) and custody exceptions (custody) stay
# off until they are needed.
ADMIN_MODULES=catalog,stock,orders,settings,users,purchasing,finance,deliveryParties,cashReceipts,returns,expenses,reports,audit

# ------------------------------------------------------------ SMS / OTP (customer sign-in)
# The API POSTs {"phone": "+964…", "code": "123456"} as JSON to this URL with
# "Authorization: Bearer <token>"; any non-2xx answer fails the request.
# Keep the URL as `disabled` until a provider is chosen. In that mode no
# outbound request is made and OTP requests return SMS_NOT_CONFIGURED (503).
SMS_GATEWAY_URL=disabled
SMS_GATEWAY_TOKEN=
# Abort a provider request after this many milliseconds (1,000-60,000).
SMS_GATEWAY_TIMEOUT_MS=10000
# How long a sign-in code is valid, seconds (60–900).
OTP_TTL_SECONDS=300

# ------------------------------------------------------------ push notifications (docs/deploy/push-notifications.md)
# disabled | fcm. Leave disabled until the Firebase key is installed.
NOTIFICATION_PROVIDER=disabled
FCM_PROJECT_ID=
# The Firebase service-account JSON, base64-encoded. SET ONLY ON THE SERVER,
# by the key holder, directly in .env.production — never in git, chat or e-mail.
FCM_SERVICE_ACCOUNT_JSON_BASE64=
# Optional allow-lists for `npm run push:test` (phones / staff usernames).
PUSH_TEST_ACCOUNTS=
PUSH_TEST_OPERATORS=

# ------------------------------------------------------------ backups (deploy/backup)
# Daily at 03:30 Baghdad time: pg_dump + picture mirror to the off-server target.
BACKUP_SCHEDULE=30 3 * * *
BACKUP_RETENTION_DAYS=14
# The target, as an rclone remote path. The "offsite" remote is defined in
# BACKUP_RCLONE_CONF (git-ignored; examples in docs/deploy/production.md):
# an S3 bucket at another provider, or SFTP to another server.
BACKUP_TARGET=offsite:shubayr-backups
# Warn after a successful backup when the complete off-site target exceeds
# this many decimal GB. The warning never fails the backup or changes health.
BACKUP_TARGET_WARN_GB=8
# Optional HTTPS monitor URL. Kept secret; backup logs never print it.
BACKUP_HEARTBEAT_URL=
# Optional provider failure path; Healthchecks.io uses /fail.
BACKUP_HEARTBEAT_FAIL_SUFFIX=
# Relative to the checkout, or an absolute path outside it (for example
# /etc/shubayr/rclone.conf, root:600 in a 711 directory: the scripts only test
# that it exists; the backup container reads it as root).
BACKUP_RCLONE_CONF=./deploy/secrets/rclone.conf

# ------------------------------------------------------------ other
LOYALTY_POINTS_PER_CURRENCY_UNIT=1
