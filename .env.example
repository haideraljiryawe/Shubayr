# =====================================================================
# Shubayr — root environment for docker compose
# Copy to .env:   cp .env.example .env
# =====================================================================

# --- Database (PostgreSQL) ---
DB_DATABASE=shubayr
DB_USERNAME=shubayr
DB_PASSWORD=shubayr_secret
DB_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Meilisearch ---
MEILI_MASTER_KEY=masterKey_dev_only
MEILI_PORT=7700

# --- Dev tools ---
ADMINER_PORT=8081
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- API ---
DATABASE_URL=postgresql://shubayr:shubayr_secret@db:5432/shubayr?schema=public
REDIS_URL=redis://redis:6379
MEILI_HOST=http://search:7700
JWT_SECRET=change_me_before_deployment
API_PORT=8000

# --- White-label defaults (used to seed store_settings) ---
STORE_NAME=Shubayr
STORE_CURRENCY=IQD
STORE_PRIMARY_COLOR=#0B2A54
