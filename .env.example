# =====================================================================
# Shubayr — root environment for docker compose
# Copy to .env:   cp .env.example .env
# =====================================================================

# --- Database (PostgreSQL) ---
DB_DATABASE=shubayr
DB_USERNAME=shubayr
DB_PASSWORD=shubayr_secret
DB_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Meilisearch ---
MEILI_MASTER_KEY=masterKey_dev_only
MEILI_PORT=7700

# --- Dev tools ---
ADMINER_PORT=8081
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- API ---
DATABASE_URL=postgresql://shubayr:shubayr_secret@db:5432/shubayr?schema=public
REDIS_URL=redis://redis:6379
MEILI_HOST=http://search:7700
JWT_SECRET=development_access_secret_change_me_123456
JWT_REFRESH_SECRET=development_refresh_secret_change_me_12345
DEV_OTP=000000
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:3200
API_PORT=8000

# --- Web Admin (admin/) ---
# Public origin of the admin; also used for its CSRF Origin check and added
# to the API's CORS_ORIGINS default in docker-compose.yml.
ADMIN_ORIGIN=http://localhost:3200
ADMIN_PORT=3200
# Session cookies are httpOnly + SameSite=Strict and Secure by default
# (browsers accept Secure on http://localhost). Only for plain-HTTP dev hosts:
ADMIN_COOKIE_SECURE=true

# --- Object storage ---
# Retained for local compatibility; Compose maps these values to SeaweedFS's
# S3 access-key environment variables.
MINIO_ROOT_USER=shubayr
MINIO_ROOT_PASSWORD=shubayr_minio_secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=shubayr-media

# --- White-label defaults (used to seed store_settings) ---
STORE_NAME=Shubayr
STORE_CURRENCY=IQD
STORE_PRIMARY_COLOR=#0B2A54
